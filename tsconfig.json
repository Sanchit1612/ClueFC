{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "lib": [
      "ES2023"
    ]
  },
  "include": [
    "apps/server/**/*.ts",
    "packages/**/*.ts"
  ]
}